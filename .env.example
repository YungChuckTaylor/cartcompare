# ---------------------------------------------------------------------------
# CartCompare — environment
# Copy to `.env` and fill in. The app runs with NONE of these set (demo mode).
# ---------------------------------------------------------------------------

# Port the server listens on. Bind host is always 0.0.0.0.
PORT=4173

# Datafiniti API token. Portal -> account menu -> My Account -> API token.
# Leave empty to run on the built-in demo dataset.
DATAFINITI_API_KEY=

# The 1,000-record free trial is time-boxed and metered. Every record that
# comes back costs 1 credit, so these two knobs are your spending controls.
DATAFINITI_MAX_RECORDS_PER_CALL=10
# Cache TTL in hours. Re-querying the same UPC inside this window is free.
CACHE_TTL_HOURS=24

# Hard stop: refuse live calls once this many credits have been spent.
# Set it to something well under 1000 so you cannot accidentally burn the trial.
CREDIT_BUDGET=250

# Field used to look a product up by barcode. Datafiniti's product schema
# exposes `upca`, `ean`, `isbn`, `asin`, `sku`. If lookups return nothing on
# live data, confirm the right field in the portal and change this.
DATAFINITI_UPC_FIELD=upca

# Optional second attempt by product name when a barcode lookup finds nothing.
# Useful, but it doubles the cost of a miss. Off by default.
FALLBACK_NAME_QUERY=false

# How old an offer may be, in days, before it is refused. Datafiniti keeps price
# observations for years, so without this a 2017 marketplace price can win a
# 2026 comparison. Measured effect: one Funyuns record had 79 offers older than
# 180 days. 0 disables the gate.
OFFER_MAX_AGE_DAYS=180

# The GET form of /api/compare (…?items=UPC:QTY,UPC:QTY). It spends credits, so
# it is off unless set to 1. The UI uses POST and does not need it.
ALLOW_GET_COMPARE=0

# How many product records a search pulls. A Datafiniti record usually carries
# one retailer's offers, so too small a sample returns single-merchant products
# with nothing to compare. 10 is the API ceiling for a non-download search and
# costs 10 credits on a cache miss.
SEARCH_RECORDS=10

# Category every shopper search is pinned to. "Food, Beverages & Tobacco" (the
# Google/Flipp name) exists but matches only 2,218 records, all one-off Shopify
# storefronts with no US merchant price. This is the one with the offers in it.
SEARCH_CATEGORY=Grocery & Gourmet Food

# How many pages of results one search may load as the shopper scrolls.
# /v4/products/search caps at 10 records; paging past that uses
# /v4/product/paginate. Each page costs SEARCH_RECORDS credits, so the default
# of 5 means one full scroll spends 50 credits.
SEARCH_MAX_PAGES=5
